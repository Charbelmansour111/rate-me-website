# Copy to .env.local for local development. Never commit .env.local or real keys.
# NEXT_PUBLIC_* values are visible in the browser and are read at build time: redeploy after a change.

# --- Public site settings (empty = hidden on the page) ---
NEXT_PUBLIC_SITE_URL=https://getrateme.space
NEXT_PUBLIC_COMMUNITY_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=

# --- Waitlist (server only) ---
# brevo | mailerlite | mock (mock keeps signups in memory and is refused in production)
WAITLIST_PROVIDER=mock
BREVO_API_KEY=
BREVO_LIST_ID=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# --- Cloudflare Turnstile (off by default; redeploy after a change) ---
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cookieless analytics, Plausible style (off by default) ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DOMAIN=getrateme.space
NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
